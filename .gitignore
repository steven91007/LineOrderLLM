# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment and credentials
.env
*.json
credentials.json
aesthetic-rush-323802-7f5591bc4a1c.json

# IDE files
.idea/

# Customer order data (contains names, phone numbers, addresses, last five digits of transfer accounts; must never be committed)
*.xlsx
*.xls
*.csv

# External demo files kept for reference (contain other parties' supplier names, part numbers and email contents; must never be committed)
agentdemo_*.html

# Claude Code local settings (.claude/commands/ holds shared slash commands and is versioned)
.claude/*
!.claude/commands/

# gitkb: the SQLite index can be rebuilt from the knowledge/ notes; pending/summaries are scratch files
knowledge/index.db
knowledge/index.db-wal
knowledge/index.db-shm
knowledge/pending.json
knowledge/summaries.json
knowledge/**/.*.md.tmp

# Self-signed TLS certificate and private key: regenerate locally with ./setup_ssl.sh; never commit them
ssl/*.pem
