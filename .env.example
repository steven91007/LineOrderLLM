# LINE Bot settings
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# OpenAI settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-0125-preview

# DSPy settings
DSPY_API_KEY=your_dspy_api_key_here  # Can be the same as OPENAI_API_KEY
DSPY_MODEL=gpt-4-0125-preview
DSPY_MAX_RETRIES=3

# TypeSafe Jev (get an API key at https://typesafe.ai)
TYPESAFE_API_KEY=your_typesafe_api_key_here
# Optional; leave empty to use the API's default model
TYPESAFE_MODEL=
# Item judgment backend: gpt (current behavior) / shadow (use GPT, also record whether Jev agrees) / jev
ITEM_JUDGE_BACKEND=gpt
JEV_CONFIDENCE_FLOOR=0.5
JEV_CONFIDENCE_REVIEW=0.8
JEV_TIMEOUT_SECONDS=10

# Order parsing client type ('openai' or 'dspy')
ORDER_CLIENT_TYPE=dspy

# Google Sheets settings
GOOGLE_SHEETS_ID=your_google_sheet_id_here
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json

# Authorized users (comma-separated user IDs, or * to allow all users)
AUTHORIZED_USERS=your_line_user_id_1,your_line_user_id_2

# Flask settings
PORT=5000
DEBUG=false
# Langfuse tracing settings (if unset, tracing is silently disabled; functionality is unaffected)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: Langfuse v4 environment and release (process level). Use production on the production server, development for local testing
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=

# Discord Bot settings
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Optional. Leave empty = bot can only be used via DM (recommended; no need to enable MESSAGE CONTENT INTENT)
# Only fill this in to use it in a server channel: enable Developer Mode, then right-click the channel -> Copy Channel ID
DISCORD_ORDER_CHANNEL_ID=
# Optional; if set, slash commands take effect immediately in that server instead of waiting for global sync
DISCORD_GUILD_ID=
# Discord user IDs allowed to use the bot (comma-separated). If empty, the bot refuses to start; it does NOT allow everyone
DISCORD_AUTHORIZED_USERS=your_discord_user_id_1,your_discord_user_id_2
# How long the import preview buttons stay valid, in seconds (default 1 hour)
DISCORD_CONFIRM_TIMEOUT=3600

# --- gitkb (git history knowledge base, optional) ---
# Directory for notes and the index (relative to the repo root)
GITKB_KNOWLEDGE_DIR=knowledge
# A single file's diff over this many bytes is truncated; if a whole commit exceeds the total, the remaining files are reduced to headers only
GITKB_PER_FILE_CAP_BYTES=65536
GITKB_TOTAL_CAP_BYTES=400000
# Paths whose content is not summarized (comma-separated globs). Keep knowledge/**, otherwise the notes themselves get summarized again
GITKB_EXCLUDE_GLOBS=knowledge/**
