# LINE Bot 設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# OpenAI 設定
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-0125-preview

# DSPy 設定
DSPY_API_KEY=your_dspy_api_key_here  # 可與 OPENAI_API_KEY 相同
# 可省略供應商前綴（預設補 openai/）；要換供應商就寫成 anthropic/... 或 gemini/...
DSPY_MODEL=gpt-5.6-luna
DSPY_MAX_RETRIES=3

# 訂單解析客戶端類型 ('openai' 或 'dspy')
ORDER_CLIENT_TYPE=dspy

# Google Sheets 設定
GOOGLE_SHEETS_ID=your_google_sheet_id_here
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json

# 授權用戶設定（用逗號分隔多個用戶ID，或使用 * 允許所有用戶）
AUTHORIZED_USERS=your_line_user_id_1,your_line_user_id_2

# Flask 設定
PORT=5000
DEBUG=false
# Langfuse 追蹤設定（沒設定時追蹤會靜默停用，不影響功能）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Discord Bot 設定
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# 選填。留空＝只能私訊機器人（建議，不用開 MESSAGE CONTENT INTENT）
# 想在伺服器頻道裡用才需要填：開發者模式開啟後，右鍵頻道 → 複製頻道 ID
DISCORD_ORDER_CHANNEL_ID=
# 選填；設了斜線指令會立即在該伺服器生效，不用等全域同步
DISCORD_GUILD_ID=
# 允許使用的 Discord 使用者 ID（逗號分隔）。留空會拒絕啟動，不會變成允許所有人
DISCORD_AUTHORIZED_USERS=your_discord_user_id_1,your_discord_user_id_2
# 匯入預覽按鈕的有效秒數（預設 1 小時）
DISCORD_CONFIRM_TIMEOUT=3600
