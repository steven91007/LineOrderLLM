# LINE Bot 設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# OpenAI 設定
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-0125-preview

# DSPy 設定
DSPY_API_KEY=your_dspy_api_key_here  # 可與 OPENAI_API_KEY 相同
DSPY_MODEL=gpt-4-0125-preview
DSPY_MAX_RETRIES=3

# 訂單解析客戶端類型 ('openai' 或 'dspy')
ORDER_CLIENT_TYPE=dspy

# Google Sheets 設定
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json

# 授權用戶設定（用逗號分隔多個用戶ID，或使用 * 允許所有用戶）
AUTHORIZED_USERS=your_line_user_id_1,your_line_user_id_2

# Flask 設定
PORT=5000
DEBUG=false